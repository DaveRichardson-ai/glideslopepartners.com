    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@fontsource/inter-tight": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "html-validate": "^11.21.0",
    "mimetext": "^3.0.28",
    "nodemailer": "^10.4.0",
    "pa11y-ci": "^5.0.0",
    "satori": "^0.63.2",
