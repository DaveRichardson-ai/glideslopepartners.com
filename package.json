{
  "name": "glideslopepartners.com",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev dist --port 8788",
    "check": "astro check && tsc -p functions/tsconfig.json",
    "validate": "html-validate \"dist/**/*.html\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:states": "node scripts/test-insight-states.mjs",
    "lhci": "lhci autorun",
    "pa11y": "node scripts/pa11y.mjs",
    "verify": "npm run check && npm run build && npm run validate && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/rss": "^4.0.19",
