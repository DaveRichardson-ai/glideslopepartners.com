---
import 'virtual:tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { hasInsights } from '../lib/insights';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  turnstile?: 'eager' | 'lazy';
  current?: string | undefined;
}

const { title, description, noindex = false, ogType = 'website', jsonLd = [], turnstile, current } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url).href;
const ogKey = pathname === '/' ? 'home' : pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogImage = new URL(Astro.props.ogImage ?? `/og/${ogKey}.png`, site.url).href;
const showInsights = await hasInsights();
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0F1C2E" />
    {showInsights && <link rel="alternate" type="application/rss+xml" title="Glideslope Partners insights" href="/rss.xml" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
  </head>
  <body data-cf-beacon={beaconToken || undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header showInsights={showInsights} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer showInsights={showInsights} />
    <script>
      import '../scripts/track';
    </script>
    {turnstile && (
      <script>
        import '../scripts/contact-form';
      </script>
    )}
  </body>
</html>
