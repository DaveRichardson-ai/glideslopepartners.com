---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import CtaBand from '../components/CtaBand.astro';
import { authors } from '../data/authors';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import stingCaptions from '../assets/video/glideslope-brand-sting.vtt?url';
import stingPoster from '../assets/video/glideslope-brand-sting-poster.jpg';

// JPEG poster for the widest support (older iOS Safari has no WebP).
const poster = await getImage({ src: stingPoster, width: 1280, format: 'jpg', quality: 80 });

const david = authors['david-richardson'];
const philip = authors['philip-hyde'];

const partners = [
  {
    a: david,
    bio: 'David specialises in M&A separation and integration: large, multi-jurisdictional transactions in regulated environments. He combines programme design with hands-on execution to hold timelines, control cost and manage risk, including leading the separation of regulated entities across Australia and other jurisdictions.',
    roles: [
      'Separation of AMP Capital International Infrastructure to DigitalBridge',
      'Carve-out of AMP Capital Domestic Private Markets to Dexus',
      'End-to-end separation of AMP Advice and transition to Entireti and AZ NGA',
      'Financial services transformation programmes at Citi, Commonwealth Bank and AMP Capital across Australia, the UK, Singapore and Japan',
    ],
  },
  {
    a: philip,
    bio: 'Phil leads complex separations, carve-outs and operating model transformations. He has led technology and data separations across more than 270 applications, designed and negotiated transitional service agreements, and cut a technology run cost from $13 million to under $2 million.',
    roles: [
      'Separation of AMP Life to Resolution Life',
      'Carve-out of AMP Capital to multiple buyers',
      'End-to-end technology transformation of AMP Advice and transition to Entireti',
      'BPO readiness assessment for a major Australian financial services institution',
      'Enterprise transformation design and business case, technology simplification and finance transformation',
    ],
  },
];

const jsonLd = partners.map(({ a, bio }) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: a.name,
  jobTitle: a.role,
  description: bio,
  image: `${site.url}/og/about.png`,
  sameAs: [a.linkedin],
  worksFor: { '@type': 'ProfessionalService', '@id': `${site.url}/#organisation`, name: site.name, url: `${site.url}/` },
  address: { '@type': 'PostalAddress', addressLocality: site.locality, addressRegion: site.region, addressCountry: 'AU' },
}));
---

<Base
  title="About — Glideslope Partners"
  description="Built by practitioners, delivered by partners. Meet David Richardson and Philip Hyde, who ran separations from inside the institutions being separated."
  jsonLd={jsonLd}
  current="/about/"
>
  <section class="ink page-hero">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1 class="title">Built by practitioners. Delivered by partners.</h1>
      <p class="lead">
        We ran separations from inside the institutions being separated, and in consulting roles alongside them.
        Glideslope is the advisory we wanted when we were on the client side of the table.
      </p>
    </div>
  </section>

  <section class="wrap section-96">
    <div class="grid principles">
      <div>
        <p class="eyebrow">Why we started</p>
        <h2 class="h2 h2--sm">The value lost between the data room and Day 1 is avoidable.</h2>
      </div>
      <div class="stack muted">
        <p>
          Transition advice tended to be expensive, slow to mobilise, or arrive after close with no context from diligence.
          By then the price was fixed, the TSAs were signed and the problems were locked in.
        </p>
        <p>
          Glideslope closes that gap. We enter during diligence, design the transition before close and run Day 1. Where
          the deal creates a transformation opportunity, we stay to help deliver it.
        </p>
        <p>
          We also work outside active deals. Private equity firms and corporates engage us on legacy modernisation,
          platform rationalisation and operating model redesign, with the same people and the same approach.
        </p>
      </div>
    </div>
  </section>

  <section id="name" class="ink">
    <div class="wrap section-96 grid sting">
      <div>
        <p class="eyebrow">Behind the name</p>
        <h2 class="h2 h2--sm">Two white, two amber: on slope.</h2>
        <p class="lead lead--body">
          A glideslope is the path an aircraft follows from entry to touchdown. Pilots confirm they are on it by reading four
          lights beside the runway: two white and two red means on slope. Our mark uses those four lights, with amber in place
          of red, as the visible sign of a transition that is on track.
        </p>
      </div>
      <figure class="sting-video">
        <video
          controls
          playsinline
          muted
          preload="none"
          width="1280"
          height="720"
          poster={poster.src}
          aria-describedby="sting-caption"
          data-track="video"
          data-track-label="about-brand-sting"
        >
          <source src="/media/glideslope-brand-sting-v1.mp4" type="video/mp4" />
          <track kind="captions" src={stingCaptions} srclang="en-AU" label="English (descriptions)" />
        </video>
        <figcaption id="sting-caption" class="fine">
          Brand animation, 24 seconds, no sound. Four white approach lights; two turn amber, then the Glideslope wordmark
          appears.
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="partners" class="raised">
    <div class="wrap section-96">
      <p class="eyebrow">Partners</p>
      <h2 class="h2 h2--sm partners-heading">The people you will work with.</h2>
      {
        partners.map(({ a, bio, roles }) => (
          <article class="partner">
            <Portrait src={a.portrait} alt={a.name} widths={[360, 600]} sizes="(min-width: 640px) 360px, 92vw" />
            <div class="body">
              <h3>{a.name}</h3>
              <p class="role">{a.role}</p>
              <p class="muted bio-lg">{bio}</p>
              <p class="label">Selected prior roles</p>
              <ul class="bullets">
                {roles.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
              <a
                class="text-link"
                href={a.linkedin}
                rel="noopener"
                data-track="outbound"
                data-track-label={`about-linkedin-${a.id}`}
                aria-label={`${a.name} on LinkedIn`}
              >
                LinkedIn
              </a>
            </div>
          </article>
        ))
      }
      <p class="fine partners-note">
        Transactions listed were led by our partners in prior roles. Client names are shown where the transaction is public.
      </p>
    </div>
  </section>

  <section class="wrap section-96">
    <div class="grid trio">
      <div>
        <h2>How we work</h2>
        <p>
          We take a small number of engagements at a time, and a founding partner is directly involved in every one. We
          work alongside your people. We set the programme up, mobilise the governance and step back once it runs, rather
          than embedding for the duration.
        </p>
      </div>
      <div>
        <h2>AI in practice</h2>
        <p>
          Our partners design, build, test and govern AI tools for regulated M&amp;A work. That gives us a grounded view of
          where AI adds value in a transition and where judgement has to stay with people.
        </p>
      </div>
      <div>
        <h2>ClarityIntel</h2>
        <p class="venture-p">
          An associated venture providing AI-assisted due diligence for M&amp;A, hosted in Australia. We use it to read a
          data room faster.
        </p>
        <a class="text-link" href={site.clarityIntel} rel="noopener" data-track="outbound" data-track-label="about-clarityintel">clarityintel.ai</a>
      </div>
    </div>
  </section>

  <CtaBand heading="Talk to a partner about your transaction." label="about-cta-band" />
</Base>
