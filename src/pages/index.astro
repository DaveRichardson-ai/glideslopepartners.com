---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import InsightCard from '../components/InsightCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { authors } from '../data/authors';
import { site } from '../data/site';
import { getPublishedInsights } from '../lib/insights';

const latest = (await getPublishedInsights()).slice(0, 3);
const david = authors['david-richardson'];
const philip = authors['philip-hyde'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#organisation`,
    name: site.name,
    url: `${site.url}/`,
    logo: `${site.url}/icon-512.png`,
    image: `${site.url}/og/home.png`,
    email: site.email,
    taxID: site.abnDigits,
    description:
      'M&A transition and transformation advisory in Sydney. Partner-led separations, integrations and TSAs for acquirers, sellers and private equity in regulated sectors.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: site.locality,
      addressRegion: site.region,
      addressCountry: 'AU',
    },
    areaServed: { '@type': 'Country', name: 'Australia' },
    sameAs: [site.linkedin],
    founder: [
      { '@type': 'Person', name: david.name, jobTitle: david.role, sameAs: david.linkedin },
      { '@type': 'Person', name: philip.name, jobTitle: philip.role, sameAs: philip.linkedin },
    ],
  },
];
---

<Base
  title="M&A transition advisory, Sydney — Glideslope Partners"
  description="Partner-led separations, integrations and TSAs for acquirers, sellers and private equity in regulated sectors. From diligence to value realisation."
  jsonLd={jsonLd}
  current="/"
  turnstile="lazy"
>
  <section class="ink hero">
    <div class="wrap">
      <p class="eyebrow">M&amp;A transition · Transformation · Sydney · Melbourne · Brisbane</p>
      <h1 class="display">Deal value is decided between the data room and Day 1.</h1>
      <p class="lead">
        We plan and run separations, integrations and the transformation that follows. Partner-led from diligence to
        value realisation, for acquirers, sellers and private equity in regulated sectors.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="#contact" data-track="cta" data-track-label="hero-talk-to-a-partner">Talk to a partner</a>
        <a class="btn btn--outline" href="#approach">How we work</a>
      </div>
      <div class="hero-record">
        <p class="label">Example transitions our partners have led or held leading roles in</p>
        <ul class="grid">
          <li>AMP Capital Infrastructure → DigitalBridge</li>
          <li>AMP Capital Private Markets → Dexus</li>
          <li>AMP Advice → Entireti</li>
          <li>AMP Life → Resolution Life</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="approach" class="wrap section">
    <div class="split intro-split">
      <div>
        <p class="eyebrow">Where we come in</p>
        <h2 class="h2">Transition design starts before the price is fixed.</h2>
      </div>
      <p>
        Most advisers arrive after close, without the context of the data room. We enter during diligence, so the Day 1
        plan, TSA scope and cost to achieve are known when they still affect the deal.
      </p>
    </div>
    <ol class="lifecycle grid">
      <li>
        <p class="num">01</p>
        <h3>Diligence</h3>
        <p>Transition risk, stranded cost and TSA scope sized before price and terms are settled.</p>
      </li>
      <li>
        <p class="num">02</p>
        <h3>Signing</h3>
        <p>Separation Management Plan, TSA schedules and the Day 1 operating model agreed with the counterparty.</p>
      </li>
      <li>
        <p class="num">03</p>
        <h3>Day 1</h3>
        <p>Transition office running, cutover executed, regulator notifications made, customers and staff unaffected.</p>
      </li>
      <li>
        <p class="num">04</p>
        <h3>Day 2</h3>
        <p>TSA exit, application and data migration, synergy capture tracked against the business case.</p>
      </li>
      <li>
        <p class="num">05</p>
        <h3>Value</h3>
        <p>The operating model and technology transformation the deal made possible.</p>
      </li>
    </ol>
  </section>

  <section id="services" class="raised">
    <div class="wrap section">
      <p class="eyebrow">Services</p>
      <h2 class="h2">Two practices, one team. Deal-driven or standalone.</h2>
      <div class="grid practice">
        <div>
          <div class="practice-head">
            <h3><a class="plain-link" href="/services/#transition">M&amp;A Transition</a></h3>
            <span>Diligence → Day 2</span>
          </div>
          <div class="practice-item">
            <h4>Transition planning &amp; design</h4>
            <p>Future-state operating model across technology, people, process and data. Separation Management Plans, roadmaps and cost to achieve.</p>
          </div>
          <div class="practice-item">
            <h4>Separation &amp; integration delivery</h4>
            <p>Transition office stand-up, programme leadership, specialist resourcing and synergy tracking through to TSA exit.</p>
          </div>
          <div class="practice-item">
            <h4>TSA design &amp; governance</h4>
            <p>Service schedules, pricing, service levels and exit plans, with TSAs treated as material arrangements under CPS 230.</p>
          </div>
          <div class="practice-item">
            <h4>Vendor-side separation readiness</h4>
            <p>Make the business separable before the sale process starts, so entanglement does not become a price chip.</p>
          </div>
        </div>
        <div>
          <div class="practice-head">
            <h3><a class="plain-link" href="/services/#transformation">Transformation</a></h3>
            <span>Post-deal or standalone</span>
          </div>
          <div class="practice-item">
            <h4>Technology transformation</h4>
            <p>Diagnostic, target-state architecture, business case and mobilisation. Legacy simplification and platform rationalisation.</p>
          </div>
          <div class="practice-item">
            <h4>Operating model &amp; BPO / ITO</h4>
            <p>Operating model redesign, sourcing strategy, vendor selection, transition and cutover, insourcing and contract exit.</p>
          </div>
          <div class="practice-item">
            <h4>Programme assurance</h4>
            <p>Independent stage-gate assurance for boards and executives on transitions, outsourcing and major change.</p>
          </div>
          <div class="practice-item">
            <h4>AI in operations</h4>
            <p>Blended human and AI workforce design, governed for APRA-regulated environments.</p>
          </div>
        </div>
      </div>

      <div class="start-panel">
        <h3 class="label">Fixed-scope ways to start</h3>
        <div class="grid">
          <div>
            <h4>Transition diligence sprint</h4>
            <p>2–3 weeks, pre-signing. Separation complexity, TSA scope, stranded cost and Day 1 risk, in a form the deal team can price.</p>
          </div>
          <div>
            <h4>TSA health check</h4>
            <p>2 weeks, post-close. Service coverage, exit readiness and CPS 230 treatment of each schedule.</p>
          </div>
          <div>
            <h4>Programme assurance review</h4>
            <p>3–4 weeks. An independent read on a programme in flight, reported to the sponsor.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid principles">
      <div>
        <p class="eyebrow">How we work</p>
        <h2 class="h2">Senior people who have sat on the client side of the table.</h2>
        <p class="muted intro-p">
          Our partners ran separations from inside the institutions being separated. We know what the steering committee
          needs to see, where the TSA will leak, and what APRA will ask.
        </p>
      </div>
      <div>
        <div class="item">
          <h3>A partner on every engagement</h3>
          <p>We cap how many engagements we run at once so that holds in practice, not only in the proposal.</p>
        </div>
        <div class="item">
          <h3>Regulated by default</h3>
          <p>CPS 230, CPS 234, SPS 515, ASIC and AUSTRAC obligations are designed into the transition plan from the start.</p>
        </div>
        <div class="item">
          <h3>Set up, then step back</h3>
          <p>We build the programme and governance to run with your people, and scale down once it does.</p>
        </div>
        <div class="item">
          <h3>Boutique economics</h3>
          <p>No leverage pyramid. You pay for the people doing the work.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="record" class="ink">
    <div class="wrap section">
      <p class="eyebrow">Track record</p>
      <h2 class="h2 h2--wide">Example transitions our partners have led or held leading roles in.</h2>
      <div class="grid record-grid">
        <div>
          <p class="meta">Wealth · Advice</p>
          <h3>AMP Advice → Entireti and AZ NGA</h3>
          <p>End-to-end separation and transition of AMP's advice business, including technology transformation.</p>
        </div>
        <div>
          <p class="meta">Infrastructure · Global</p>
          <h3>AMP Capital International Infrastructure → DigitalBridge</h3>
          <p>Multi-jurisdictional separation of a regulated asset management platform.</p>
        </div>
        <div>
          <p class="meta">Private markets</p>
          <h3>AMP Capital Domestic Private Markets → Dexus</h3>
          <p>Carve-out of the domestic real estate and infrastructure equity business.</p>
        </div>
        <div>
          <p class="meta">Life insurance</p>
          <h3>AMP Life → Resolution Life</h3>
          <p>Separation of a life insurer from its parent, technology and data stream.</p>
        </div>
      </div>
      <div class="grid stats">
        <div>
          <p class="figure">270+</p>
          <p>applications separated in a single technology and data separation</p>
        </div>
        <div>
          <p class="figure">$13M → &lt;$2M</p>
          <p>annual technology run cost after separation and simplification</p>
        </div>
        <div>
          <p class="figure">4</p>
          <p>countries of delivery: Australia, UK, Singapore and Japan</p>
        </div>
      </div>
      <p class="fine record-note">Led by our partners in prior roles. Client names are shown where the transaction is public.</p>
      <p class="label record-sectors">
        Sectors · Banking · Wealth &amp; superannuation · Life insurance · Infrastructure &amp; private markets · Technology
      </p>
    </div>
  </section>

  <section id="team" class="wrap section">
    <p class="eyebrow">Team</p>
    <h2 class="h2">The people you will work with.</h2>
    <div class="grid team">
      <article>
        <Portrait src={david.portrait} alt={david.name} widths={[320, 440, 600]} sizes="(min-width: 960px) 416px, (min-width: 640px) 45vw, 92vw" />
        <h3>{david.name}</h3>
        <p class="role">{david.role}</p>
        <p class="bio">
          Large-scale, multi-jurisdictional separations and integrations in regulated financial services. Programme
          Director on the AMP Advice separation and the AMP Capital separations to DigitalBridge and Dexus. Earlier
          operating model work at Commonwealth Bank and Citi across Australia, the UK, Singapore and Japan.
        </p>
        <a class="text-link" href={david.linkedin} rel="noopener" data-track="outbound" data-track-label="home-linkedin-david" aria-label="David Richardson on LinkedIn">LinkedIn</a>
      </article>
      <article>
        <Portrait src={philip.portrait} alt={philip.name} widths={[320, 440, 600]} sizes="(min-width: 960px) 416px, (min-width: 640px) 45vw, 92vw" />
        <h3>{philip.name}</h3>
        <p class="role">{philip.role}</p>
        <p class="bio">
          Technology and data separations, TSA design and negotiation, and operating model transformation. Led
          separations across 270+ applications, including AMP Life to Resolution Life and the AMP Capital carve-out to
          multiple buyers.
        </p>
        <a class="text-link" href={philip.linkedin} rel="noopener" data-track="outbound" data-track-label="home-linkedin-philip" aria-label="Philip Hyde on LinkedIn">LinkedIn</a>
      </article>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section id="insights" class="raised">
        <div class="wrap section">
          <div class="split">
            <div>
              <p class="eyebrow">Insights</p>
              <h2 class="h2">What we are seeing on deals.</h2>
            </div>
            <a class="text-link" href="/insights/">All insights</a>
          </div>
          <div class="grid cards">
            {latest.map((i) => <InsightCard insight={i} variant="home" />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="wrap venture">
    <div class="venture-box">
      <div>
        <p class="label">Associated venture</p>
        <p>
          <strong>ClarityIntel</strong> is AI-assisted due diligence for M&amp;A, hosted in Australia. We use it to read a data
          room faster; the judgement stays with our partners.
        </p>
      </div>
      <a class="text-link" href={site.clarityIntel} rel="noopener" data-track="outbound" data-track-label="home-clarityintel">clarityintel.ai</a>
    </div>
  </section>

  <section id="contact" class="ink">
    <div class="wrap section grid contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="h2">Talk to a partner.</h2>
        <p class="lead lead--body">
          A conversation is confidential and carries no obligation. If you are pre-announcement, say so and we will keep it
          to partners only.
        </p>
        <div class="contact-details">
          <a href={`mailto:${site.email}`} data-track="mailto" data-track-label="home-email">{site.email}</a>
          <span>Sydney, New South Wales</span>
          <a href={site.linkedin} rel="noopener" data-track="outbound" data-track-label="home-linkedin-company">LinkedIn</a>
        </div>
      </div>
      <ContactForm source="home" load="lazy" rows={4} submitLabel="Send" />
    </div>
  </section>
</Base>
